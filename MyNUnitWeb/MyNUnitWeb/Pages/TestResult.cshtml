@page
@model MyNUnitWeb.Pages.TestResultModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Test results</title>
    <link rel="stylesheet" href="~/css/navigationBar.css" />
    <link rel="stylesheet" href="~/css/results.css" />
</head>
<body>
    <div class="navigation_bar">
        <h1 class="MyNUnitWeb_title">MyNUnitWeb</h1>
        <div class="redirections">
            <button class="redirection" type="button"
                    onclick="document.location='/'">
                Home
            </button>
        </div>
    </div>
    <h2>Test methods results</h2>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var testResult in Model.Tests)
            {
                <tr>
                    <td>@testResult.Name</td>
                    <td>@testResult.Duration</td>
                    <td>
                        @(testResult.Status == 0 ? "Passed"
                                            : testResult.Status == 1 ? "Failed"
                                            : testResult.Status == 2 ? "Cancelled"
                                            : "Ignored")
                </td>
                <td>@testResult.Message</td>
            </tr>
            }
        </tbody>
    </table>
</body>
</html>