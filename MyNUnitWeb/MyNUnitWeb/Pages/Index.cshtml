@page
@model MyNUnitWeb.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>MyNUnitWeb</title>
    <link rel="stylesheet" href="~/css/upload.css" />
    <script src="~/js/upload.js"></script>
</head>
<body>
    <div class="container">
        <div class="upload_area_title">
            <h2>Upload assemblies into this box.</h2>
            <h3>It only can be files with ".dll" extension.</h3>
        </div>

        <div class="drop_section">
            <span class="input_message">Drag and drop your assembly files here.</span>
            <span class="or">OR</span>
            <form method="post" enctype="multipart/form-data" id="upload_form">
                <input type="file" name="files" class="input" accept=".dll" multiple />
                <button class="choose_button" type="button">Choose files</button>
            </form>
        </div>

        <div class="show_section">
            <div class="tests_running_section">
                <div class="uploaded_files_title">Uploaded files</div>
                <form method="post" asp-page-handler="Run">
                    <button type="submit" class="test_running_button">Start testing</button>
                </form>
            </div>

            <table class="table">
                @foreach (var file in Directory.GetFiles(Model.TestsDirectoryPath))
                {
                    <tr class="row">
                        <td>@file.Split("/")[^1]</td>
                        <td class="remove">
                            <form method="post" asp-page-handler="Remove" asp-route-filePath="@file">
                                <button type="submit">x</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>

            <div class="uploading_section">
                <div class="list_title">Testing files</div>
                <button type="submit" class="upload_button"
                        form="upload_form" asp-page-handler="Upload">
                    Upload
                </button>
            </div>
            <div class="list" style="border: none;">
                <div class="name">
                    <div class="file_name"></div>
                </div>
                <div class="remove">
                    <div class="remove_sign"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>